    "group_indicator": {
      "0": "normal cognition",
      "1": "MCI"
    },
    "coding": {
      "age_c": {
        "source": "UDS",
        "column": "NACCAGE",
        "expression": "NACCAGE - 68",
        "reference_years": 68.0,
        "unit": "One year",
        "rationale": "Prespecified demographic adjustment related to cognitive performance and the thickness association."
      },
      "female": {
        "source": "UDS",
        "column": "SEX",
        "code_map": {
          "1": 0,
          "2": 1
        },
        "reference": "Recorded male, SEX=1",
        "unit": "Recorded female minus recorded male, holding other included predictors fixed",
        "rationale": "Prespecified demographic adjustment; use the recorded binary codes without interpreting them as a broader gender measure."
      },
      "education_c": {
        "source": "UDS",
        "column": "EDUC",
        "expression": "EDUC - 16",
        "reference_years": 16,
        "unit": "One year",
        "rationale": "Prespecified adjustment for years of education in a cognitive-task analysis."
      },
      "thickness_0_1mm": {
        "source": "MRI",
        "column": "LH_INFERIORPARIETAL_AVGTH",
        "expression": "(LH_INFERIORPARIETAL_AVGTH - 2.344) / 0.1",
        "reference_mm": 2.344,
        "unit": "0.1 mm greater thickness",
        "rationale": "The single anatomical measure selected by the research question before Phase 4 fitting.",
        "continuous": true,
        "phase_three_cutoff_used": false
      }
    },
    "sample_rule": "Participants in eligible_model_all with the two listed cognitive codes. Use one supplied row per participant."
